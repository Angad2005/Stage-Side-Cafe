# Database
DATABASE_URL=sqlite+aiosqlite:///./stageside_local.db
STAGESIDE_DISABLE_PGVECTOR=true
POSTGRES_USER=stageside
POSTGRES_PASSWORD=stageside
POSTGRES_DB=stageside

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# LiveKit (WebRTC SFU)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Twitch Developer Console
# Register this exact redirect URL in your Twitch app:
# http://localhost:8000/api/v1/auth/twitch/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:8000/api/v1/auth/twitch/callback
TWITCH_EXTENSION_SECRET=your-twitch-extension-secret
WEB_APP_URL=http://localhost:5173

# Application Security
APP_SECRET_KEY=replace-with-a-long-random-secret-before-deploying
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost:5174

# Media Gateway
MEDIA_GATEWAY_HOST=0.0.0.0
MEDIA_GATEWAY_PORT=1935
BUFFER_DURATION_SECONDS=3.0
FRAME_SAMPLE_RATE=5

# AI Sentinel Parameters
SENTINEL_CONFIDENCE_THRESHOLD=0.70
SENTINEL_BLOCK_THRESHOLD=0.85
INFERENCE_DEVICE=cpu
